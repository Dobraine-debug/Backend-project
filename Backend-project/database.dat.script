CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.CUSTOMER(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CUSTOMERID VARCHAR(255),MAIL VARCHAR(255),NAME VARCHAR(255),TELEPHONE VARCHAR(255))
ALTER TABLE PUBLIC.CUSTOMER ALTER COLUMN ID RESTART WITH 99
CREATE MEMORY TABLE PUBLIC.CUSTOMER_INVOICE(CUSTOMER_ID BIGINT NOT NULL,INVOICES_ID BIGINT NOT NULL,CONSTRAINT UKR23CR8QSB1XFRPM0YHXUF8JSW UNIQUE(INVOICES_ID),CONSTRAINT FK7CNLSRN680WRWH5ML0GGTFV0K FOREIGN KEY(CUSTOMER_ID) REFERENCES PUBLIC.CUSTOMER(ID))
CREATE MEMORY TABLE PUBLIC.EMPLOYEE(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,EMAIL VARCHAR(255),EMPLOYEEID VARCHAR(255),NAME VARCHAR(255),TELEPHONE VARCHAR(255),CONSTRAINT UK71IS4ECSMWW9TPYNSKBMFH7P3 UNIQUE(EMPLOYEEID))
ALTER TABLE PUBLIC.EMPLOYEE ALTER COLUMN ID RESTART WITH 109
CREATE MEMORY TABLE PUBLIC.INVOICE(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,AMOUNT DOUBLE NOT NULL,INVOICEDATE DATE,INVOICEID VARCHAR(255))
ALTER TABLE PUBLIC.INVOICE ALTER COLUMN ID RESTART WITH 112
CREATE MEMORY TABLE PUBLIC.RESERVATION(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,DATE DATE,RESERVATIONID INTEGER NOT NULL,SESSION VARCHAR(255),SIZEOFPARTY INTEGER NOT NULL,CUSTOMER_ID BIGINT,RESTAURANTTABLE_ID INTEGER,CHECK((PUBLIC.RESERVATION.SESSION) IN (('FIRST_SESSION'),('SECOND_SESSION'),('THIRD_SESSION'))),CONSTRAINT FKMRFYGYY9WI4BE7NLYUOGRN24N FOREIGN KEY(CUSTOMER_ID) REFERENCES PUBLIC.CUSTOMER(ID))
ALTER TABLE PUBLIC.RESERVATION ALTER COLUMN ID RESTART WITH 128
CREATE MEMORY TABLE PUBLIC.RESTAURANTTABLE(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,NUMBEROFSEATS INTEGER NOT NULL,TABLEID VARCHAR(255))
ALTER TABLE PUBLIC.RESTAURANTTABLE ALTER COLUMN ID RESTART WITH 127
CREATE MEMORY TABLE PUBLIC.SCHEDULE(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,DATE VARCHAR(255),SCHEDULEID VARCHAR(255),EMPLOYEE_FK INTEGER,TABLE_FK INTEGER,CONSTRAINT UKAC7DBGVQ2RP40YWFTC4280J28 UNIQUE(SCHEDULEID),CONSTRAINT FK1SQ5O76GNO6NQPNWW45UN5SP0 FOREIGN KEY(EMPLOYEE_FK) REFERENCES PUBLIC.EMPLOYEE(ID),CONSTRAINT FKTORIOH79SP8XG9NB674I851RS FOREIGN KEY(TABLE_FK) REFERENCES PUBLIC.RESTAURANTTABLE(ID))
ALTER TABLE PUBLIC.SCHEDULE ALTER COLUMN ID RESTART WITH 253
ALTER TABLE PUBLIC.CUSTOMER_INVOICE ADD CONSTRAINT FKASWOX5SH1VHRUQW3NN86NSJD0 FOREIGN KEY(INVOICES_ID) REFERENCES PUBLIC.INVOICE(ID)
ALTER TABLE PUBLIC.RESERVATION ADD CONSTRAINT FKLWGEIV8A0W9FKEAENALRGU0LS FOREIGN KEY(RESTAURANTTABLE_ID) REFERENCES PUBLIC.RESTAURANTTABLE(ID)
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
